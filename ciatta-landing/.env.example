# Supabase project the waitlist writes to. Both values are safe in a browser
# bundle: the publishable key can only do what RLS allows, which here is a
# single INSERT into public.waitlist and nothing else.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Newsletter (Ciatta Briefs) --------------------------------------------
# The site's Pages Functions read these as encrypted Pages secrets, never from
# this file. Set them with:
#   npx wrangler pages secret put RESEND_API_KEY --project-name ciatta
#   npx wrangler pages secret put NEWSLETTER_SIGNING_SECRET --project-name ciatta
# For `npm run newsletter` (scheduling issues) put RESEND_API_KEY in .env.
RESEND_API_KEY=re_xxx
# 32+ random bytes, e.g. `openssl rand -base64 48`. Changing it invalidates
# every confirmation and unsubscribe link already sent.
NEWSLETTER_SIGNING_SECRET=
# Optional: a monitored inbox for replies, and the postal address US law
# (CAN-SPAM) requires in newsletter footers.
NEWSLETTER_REPLY_TO=
NEWSLETTER_POSTAL_ADDRESS=
NEWSLETTER_SEND_HOUR_UTC=13
