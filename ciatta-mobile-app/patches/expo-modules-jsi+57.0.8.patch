+// Local patch for expo/expo#50067. Swift 6.2.x reports "sending ... risks causing data races" for
+// `nonisolated(unsafe) let` pointer locals captured by the `assumeIsolated` closures above. A value
+// box marked `@unchecked Sendable` carries the same call-scoped safety contract without the
+// per-call heap allocation `NonisolatedUnsafeVar` would add on this hot path.
+fileprivate struct UnsafeSendableBox<Value>: @unchecked Sendable {
+  let value: Value
+  init(_ value: Value) { self.value = value }
