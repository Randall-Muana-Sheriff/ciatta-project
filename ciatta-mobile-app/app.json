{
  "expo": {
    "name": "ciatta-mobile-app",
    "slug": "ciatta-mobile-app",
    "scheme": "ciatta",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ciatta.mobileapp",
      "appleTeamId": "8WDZ75627S",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ciatta.mobileapp",
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_MENSTRUATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "defaultLaunchURL": "http://127.0.0.1:8081",
          "toolsButton": false,
          "skipOnboarding": true,
          "showMenuAtLaunch": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-apple-authentication",
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Health shares your activity, heart, sleep, breathing, cycle, workouts, and body measurements with Ciatta so you are not asked the same questions twice.",
          "NSHealthUpdateUsageDescription": "Health shares your activity, heart, sleep, breathing, cycle, workouts, and body measurements with Ciatta so you are not asked the same questions twice.",
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-dark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0C0E11"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.183018363133-4k2da19sr8us67t7q2588hlk2lrm94vi"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F27D72"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Calendar access helps relate your days to how you sleep and feel. Event titles stay on this device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos of lab results and health documents can be added to your picture.",
          "cameraPermission": "Ciatta uses the camera only when you take a photo of a document to keep with an entry."
        }
      ],
      "expo-document-picker",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Ciatta turns what you say into text so you can describe your health out loud instead of typing.",
          "microphonePermission": "Ciatta uses the microphone only while you are dictating, and stops as soon as you do."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "8580b2a3-074d-4fcf-bfc0-a3ce35a5c8ab"
      }
    },
    "owner": "spammaster",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8580b2a3-074d-4fcf-bfc0-a3ce35a5c8ab"
    }
  }
}
