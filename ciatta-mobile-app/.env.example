# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# EXPO_PUBLIC_ variables are safe to ship in the app bundle — the anon key
# is designed to be public and relies on Row Level Security to keep data safe.
# Never put the service_role key here or anywhere in this app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials).
# Client IDs are public identifiers and ship in the bundle by design. The Web
# client's *secret* is NOT needed for native sign-in. Do not add it here.
#
# iOS client matches app.json iosUrlScheme (reversed). The Web application
# client is the ID token audience for Supabase Auth -> Google. Until a
# dedicated Web client exists in this Google Cloud project, the iOS client
# is the only real client ID on file and must also be listed in Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=326095655806-po3vgir44qdql8s6a6ibfg1frej4am64.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=326095655806-po3vgir44qdql8s6a6ibfg1frej4am64.apps.googleusercontent.com
